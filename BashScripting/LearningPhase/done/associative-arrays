#!/usr/bin/env bash

if ! declare -A arr; then
    echo "uh oh, i couldn't make an associative array" >&2
    exit 1
fi

declare -A arr

arr[foo]=1
arr[bar]=2
arr[baz]=3

echo "value of foo: ${arr[foo]}"
echo "values: ${arr[*]}"

echo "keys: ${!arr[*]}"
echo "keys: ${!arr[@]}"

for key in "${!arr[@]}"; do
    value="${arr[$key]}"
    echo "got key: $key, and value: $value"
done